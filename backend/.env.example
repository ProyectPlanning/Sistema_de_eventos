# =============================================================
# Variables para ejecutar el backend FUERA de Docker
# (npm run start:dev). Copia este archivo como backend/.env
#
# Dentro de Docker este archivo NO se usa: allí las variables
# vienen del docker-compose.yml y del .env de la raíz.
# =============================================================

# Puerto en el que escucha NestJS
PORT=3000

# Base de datos local: el contenedor "db" con el puerto publicado.
# Fuera de Docker el nombre "db" no existe, por eso se usa localhost.
DB_HOST=localhost
DB_PORT=5432

# Deben ser IGUALES a DB_USER, DB_PASSWORD y DB_NAME del .env de la raíz,
# porque con esos valores se creó el usuario dentro del contenedor.
DB_USER=eventos_user
DB_PASSWORD=cambia_esta_clave
DB_NAME=eventos_db

DB_SSL=false